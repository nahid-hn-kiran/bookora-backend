model Venue {
  id          String      @id @default(uuid(7))
  name        String
  description String?
  address     String
  city        String
  country     String
  phone       String?
  email       String?
  image       String?
  status      VenueStatus @default(ACTIVE)

  rooms Room[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isDeleted])
  @@map("venues")
}
